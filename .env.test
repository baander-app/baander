# define your env variables for the test env here
APP_ENV=test
# Test-only secrets and credentials, accepted by the production kernels the tests boot.
APP_SECRET=test-only-app-secret-never-use-in-production
STREAM_URL_HMAC_SECRET=test-only-stream-url-secret-never-use-in-production
AUTH_TOTP_ENCRYPTION_KEY=5IG63F//ty2qMfGR70X0miwxsdGGVFfIpy61FUgK5Qc=
DATABASE_URL="postgresql://baander:test-only@database:5432/baander_test?serverVersion=18&charset=utf8"
DATABASE_CONTROL_URL="postgresql://baander:test-only@database:5432/baander_test?serverVersion=18&charset=utf8"
MESSENGER_TRANSPORT_DSN=in-memory://
REDIS_URL=redis://default:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=test-only
# Tests send requests and DPoP proofs to these origins as well as APP_URL.
AUTH_DPOP_EXTRA_ORIGINS=https://baander.app,http://localhost
