+            $needle = "\t\tcase PHP_CLI_MODE_CLI_DIRECT:\n\t\t\tcli_register_file_handles();\n";
+            $replacement = $needle . <<<'C'
+            {
+                const char *qualification = getenv("BAANDER_TYPEPHP_QUALIFICATION");
+                if (qualification && strcmp(qualification, "1") == 0
+                    && PG(auto_prepend_file) && PG(auto_prepend_file)[0]) {
+                    zend_file_handle prepend;
+                    zend_stream_init_filename(&prepend, PG(auto_prepend_file));
+                    zend_result result = zend_execute_script(ZEND_REQUIRE, NULL, &prepend);
+                    zend_destroy_file_handle(&prepend);
+                    if (result == FAILURE) {
+                        break;
+                    }
+                }
+            }
+
+C;
+            $code = $this->patchOnce($code, $needle, $replacement, 'qualification CLI direct bootstrap');
