@@ -0,0 +1,88 @@
+<?php
+
+namespace TypePhp\Build;
+
+final class RuntimeLock
+{
+    private function __construct(
+        private readonly array $data,
+        public readonly string $hash,
+    ) {
+    }
+
+    public static function load(): self
+    {
+        $path = getenv('TYPEPHP_RUNTIME_LOCK');
+        if (!is_string($path) || $path === '' || !is_file($path)) {
+            throw new \RuntimeException('TYPEPHP_RUNTIME_LOCK must name a runtime lock file');
+        }
+        $contents = file_get_contents($path);
+        if (!is_string($contents)) {
+            throw new \RuntimeException('Cannot read the TypePHP runtime lock');
+        }
+        $data = json_decode($contents, true, flags: JSON_THROW_ON_ERROR);
+        if (!is_array($data) || !isset($data['php'], $data['extensions'], $data['configure'])) {
+            throw new \RuntimeException('Invalid TypePHP runtime lock');
+        }
+        return new self($data, hash('sha256', $contents));
+    }
+
+    /** @return array{version:string,filename:string,sha256:string,url:string} */
+    public function php(string $requestedVersion): array
+    {
+        $release = $this->release($this->data['php']);
+        $branch = implode('.', array_slice(explode('.', $release['version']), 0, 2));
+        if (!in_array($requestedVersion, [$branch, $branch . '.0', $release['version']], true)) {
+            throw new \RuntimeException("PHP {$requestedVersion} does not match locked PHP {$release['version']}");
+        }
+        return $release;
+    }
+
+    /** @return array{version:string,filename:string,sha256:string,url:string} */
+    public function extension(string $extension): array
+    {
+        if (!isset($this->data['extensions'][$extension])) {
+            throw new \RuntimeException("External extension `{$extension}` is absent from the runtime lock");
+        }
+        return $this->release($this->data['extensions'][$extension]);
+    }
+
+    /** @return list<string> */
+    public function configureOptions(array $extensions): array
+    {
+        $options = [];
+        foreach ($extensions as $extension) {
+            foreach ($this->data['configure'][$extension] ?? [] as $option) {
+                if (!is_string($option) || !str_starts_with($option, '--')) {
+                    throw new \RuntimeException('Invalid locked configure option');
+                }
+                $options[] = $option;
+            }
+        }
+        return $options;
+    }
+
+    public function verify(string $archive, string $sha256): void
+    {
+        if (!is_file($archive) || !hash_equals($sha256, hash_file('sha256', $archive))) {
+            throw new \RuntimeException("Runtime source archive SHA-256 verification failed: {$archive}");
+        }
+    }
+
+    private function release(mixed $release): array
+    {
+        if (!is_array($release)
+            || !is_string($release['version'] ?? null)
+            || preg_match('/^[0-9][A-Za-z0-9._-]*$/D', $release['version']) !== 1
+            || !is_string($release['filename'] ?? null)
+            || basename($release['filename']) !== $release['filename']
+            || !is_string($release['url'] ?? null)
+            || !str_starts_with($release['url'], 'https://')
+            || !is_string($release['sha256'] ?? null)
+            || preg_match('/^[a-f0-9]{64}$/D', $release['sha256']) !== 1
+        ) {
+            throw new \RuntimeException('Invalid locked source release');
+        }
+        return $release;
+    }
+}
