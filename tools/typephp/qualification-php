#!/bin/sh
set -eu

script_argument() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -d|-c|-z|--define|--php-ini|--zend-extension)
                shift
                [ "$#" -gt 0 ] || return 0
                shift
                ;;
            -d?*|-c?*|-z?*|--define=*|--php-ini=*|--zend-extension=*)
                shift
                ;;
            -n|-q|-e|-H)
                shift
                ;;
            -f|--file)
                printf '%s' "${2:-}"
                return 0
                ;;
            -f?*)
                printf '%s' "${1#-f}"
                return 0
                ;;
            --file=*)
                printf '%s' "${1#--file=}"
                return 0
                ;;
            -*)
                return 0
                ;;
            *)
                printf '%s' "$1"
                return 0
                ;;
        esac
    done
}

script=$(script_argument "$@")

case "$script" in
    bin/worker-deployment.php|/var/www/html/bin/worker-deployment.php)
        exec /usr/local/lib/typephp/baander-operator "$@"
        ;;
    *)
        exec /usr/local/lib/typephp/baander "$@"
        ;;
esac
