{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "noEmit": true,
    "paths": {
      "@/app/*": [
        "../web/src/*"
      ],
      "@/*": [
        "../web/src/*"
      ],
      "react": [
        "../web/node_modules/@types/react"
      ],
      "react/*": [
        "../web/node_modules/@types/react/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "typings/**/*.d.ts",
    "src/preload/types/**/*.d.ts",
    "../web/src/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "release"
  ]
}
