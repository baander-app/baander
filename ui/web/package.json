{
  "name": "@baander/web",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.0.0",
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "yarn typecheck && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate": "orval",
    "generate:check": "yarn generate && git ls-files --error-unmatch src/shared/api-client/gen/endpoints/index.ts && git diff --exit-code -- src/shared/api-client/gen",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:browser-auth": "playwright test -c tests/e2e/browser-auth/playwright.config.ts",
    "test:audio-graph": "playwright test -c tests/e2e/audio-graph/playwright.config.ts",
    "test:store-debug": "playwright test -c tests/e2e/store-debug/playwright.config.ts",
    "test:typography": "playwright test -c tests/e2e/typography/playwright.config.ts",
    "e2e": "playwright test --headed -c tests/e2e/playwright.config.ts",
    "e2e:headless": "playwright test -c tests/e2e/playwright.config.ts",
    "e2e:ui": "playwright test --ui -c tests/e2e/playwright.config.ts",
    "e2e:debug": "playwright test --debug -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-myanmar": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@lucide/lab": "^0.7.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "assjs": "^0.1.10",
    "axios": "^1.21.0",
    "blurhash": "^2.0.5",
    "cmdk": "^1.1.1",
    "hls.js": "1.7.4",
    "i18next": "^26.5.12",
    "i18next-browser-languagedetector": "^8.2.4",
    "libpgs": "^0.9.0",
    "lucide": "^1.66.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "styled-components": "^6.6.0",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axios-mock-adapter": "^2.1.0",
    "dashjs": "5.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "orval": "^8.46.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-symfony": "^8.2.4",
    "vitest": "^5.0.5"
  }
}
