###> symfony/framework-bundle ###
APP_ENV=dev
# Comma-separated proxy IPs/CIDRs without spaces; empty trusts no forwarding peers.
TRUSTED_PROXIES=
# Use one secret. Rotate it with the offline procedure in the security guide.
APP_SECRET=change_me_in_production
APP_URL=https://baander.test
# Comma-separated further origins the API is reached at, such as a LAN address
# (https://192.168.1.20:8443). DPoP proofs must name APP_URL's origin or one of these.
AUTH_DPOP_EXTRA_ORIGINS=
APP_DOMAIN=http://localhost:9501
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://baander.test
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html
# For important MySQL/MariaDB settings, see: https://symfony.com/doc/current/reference/doctrine.html#doctrine-doctrine-bundle-configuration
# Web, workers and migrations use the pooler's application alias; worker leases,
# media authority and the scheduler use its control alias and role.
DATABASE_URL="postgresql://baander:baander@pooler:6432/baander?serverVersion=18&charset=utf8"
DATABASE_CONTROL_URL="postgresql://baander_control:baander@pooler:6432/baander_control?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app ###
REDIS_PASSWORD=baander
REDIS_URL=redis://default:${REDIS_PASSWORD}@redis:6379

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=redis://default:${REDIS_PASSWORD}@redis:6379/messages
MESSENGER_CONSUMER_NAME=${HOSTNAME:-worker}
###< symfony/messenger ###

# Auth - Password reset token lifetime, in minutes
PASSWORD_RESET_EXPIRE=60

# Auth - TOTP secrets are encrypted at rest with this key: 32 random bytes, base64-encoded
# (openssl rand -base64 32). Changing it locks out every TOTP user until an operator
# resets their TOTP. Development default only.
AUTH_TOTP_ENCRYPTION_KEY=vhDAUukeCl95XW2ZyaTcQbB67hk3cv0yLDiezobAarA=

# Mail
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM_ADDRESS="noreply@baander.test"

# Web Push (VAPID)
VAPID_PUBLIC_KEY=BGT1Tz8VDdPngTdQEY9i2B_LhMdlTdy-wtw-Ho6OZlepH_WesonS-FuyQT_hq1dqHW2cMm_ldcPWavY4v0GzJHg
VAPID_PRIVATE_KEY=XcgrUfkAEzytV6BH7A62gvcoNNBbBGpwK6PEcQe2wUw

# OAuth 2.0
OAUTH_PRIVATE_KEY_PATH=%kernel.project_dir%/config/secrets/oauth/private.key
OAUTH_PUBLIC_KEY_PATH=%kernel.project_dir%/config/secrets/oauth/public.key

# External APIs
DISCOGS_TOKEN=
LASTFM_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TASTE_DIVE_API_KEY=

# Media Storage
MEDIA_STORAGE_PATH=/var/www/html/storage/media
CONVERT_STORAGE_PATH=/var/www/html/storage/conversions
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
###< app ###

AUTH_SPA_CLIENT_ID=baander_dev_spa_00001

JOB_MONITOR_MAX_PAYLOAD_SIZE=20000000

###> baander/lyrics ###
LRCLIB_BASE_URL=https://lrclib.net
###< baander/lyrics ###

###> baander/navigator-otel ###
OTEL_ENABLED=true
OTEL_SERVICE_NAME=baander
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318/v1/traces
###< baander/navigator-otel ###
VIDEO_ENCODER=libx264

###> transcode/hardware-acceleration ###
HW_ACCEL_DEVICE=
HW_BITRATE_MULTIPLIER=1.0
###< transcode/hardware-acceleration ###

###> transcode/stream-auth ###
STREAM_URL_HMAC_SECRET=dev-secret-change-me-in-production
###< transcode/stream-auth ###
