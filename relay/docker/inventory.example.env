# SPDX-License-Identifier: Apache-2.0
# Configuration example only: all paths and host interface addresses require operator review.
REGISTRY_REGION=de
REGISTRY_PUBLIC_BIND_IP=0.0.0.0
REGISTRY_HEALTH_HOSTNAME=de.registry.baander.app
REGISTRY_CONFIG_FILE=/etc/baander-registry/config.json
REGISTRY_SECRETS_DIRECTORY=/etc/baander-registry/api-secrets
RQLITE_SECRETS_DIRECTORY=/etc/baander-registry/voter-secrets
# RFC1918 interface on a VPN/private network; never publish rqlite on 0.0.0.0.
RQLITE_PRIVATE_BIND_IP=10.42.0.11
RQLITE_NODE_ID=de
RQLITE_HTTP_ADVERTISE=de.rqlite.registry.baander.app:4001
RQLITE_RAFT_ADVERTISE=de.raft.registry.baander.app:4002
RQLITE_JOIN_ADDRESSES=de.raft.registry.baander.app:4002,ca.raft.registry.baander.app:4002,sg.raft.registry.baander.app:4002,au.raft.registry.baander.app:4002,fi.raft.registry.baander.app:4002
# First launch requires an explicit switch to bootstrap, or join-new for a replacement.
RQLITE_START_MODE=restart
RQLITE_VOLUME_NAME=baander-registry-voter-de
