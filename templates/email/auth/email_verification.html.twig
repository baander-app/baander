<!DOCTYPE html>
<html lang="{{ locale }}">
<body style="font-family: sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
    <div style="background: #1f2937; color: #fff; padding: 20px; border-radius: 8px 8px 0 0;">
        <h1 style="margin: 0;">{{ appName }}</h1>
    </div>
    <div style="background: #f9f9f9; padding: 20px; border: 1px solid #ddd; border-top: none;">
        <h2>{{ 'email_verification_email.heading'|trans({}, 'auth', locale) }}</h2>
        <p>{{ 'email_verification_email.greeting'|trans({name: name}, 'auth', locale) }}</p>
        <p>{{ 'email_verification_email.intro'|trans({app: appName}, 'auth', locale) }}</p>
        <a href="{{ link }}"
           style="display: inline-block; background: #1f2937; color: #fff; padding: 10px 20px; text-decoration: none; border-radius: 4px; margin: 10px 0;">
            {{ 'email_verification_email.action'|trans({}, 'auth', locale) }}
        </a>
        <p style="color: #666; font-size: 12px;">{{ 'email_verification_email.fallback'|trans({}, 'auth', locale) }}<br>
            <span style="word-break: break-all;">{{ link }}</span></p>
        <p>{{ 'email_verification_email.expiry'|trans({hours: validHours}, 'auth', locale) }}</p>
        <p>{{ 'email_verification_email.ignore'|trans({}, 'auth', locale) }}</p>
    </div>
</body>
</html>
