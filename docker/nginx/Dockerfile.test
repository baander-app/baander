FROM nginx:alpine3.24

ARG PHP_VERSION=8.5.12
ARG PHP_PACKAGE_VERSION=8.5.12-r0
ARG SWOOLE_VERSION=6.2.4
ARG SWOOLE_SHA256=cb41348708cb3a360672cd4ffe84b9a6b4efee61773be7d76a11c39949b95334

RUN apk add --no-cache bash coreutils curl libstdc++ openssl "php85=${PHP_PACKAGE_VERSION}" "php85-sockets=${PHP_PACKAGE_VERSION}" util-linux \
    && apk add --no-cache --virtual .php-build autoconf g++ linux-headers make openssl-dev "php85-dev=${PHP_PACKAGE_VERSION}" pkgconf \
    && curl -fsSL "https://pecl.php.net/get/swoole-${SWOOLE_VERSION}.tgz" -o /tmp/swoole.tgz \
    && echo "${SWOOLE_SHA256}  /tmp/swoole.tgz" | sha256sum -c - \
    && mkdir /tmp/swoole \
    && tar -xzf /tmp/swoole.tgz -C /tmp/swoole --strip-components=1 \
    && cd /tmp/swoole \
    && phpize85 \
    && ./configure --with-php-config=/usr/bin/php-config85 --enable-sockets --disable-brotli \
    && make -j4 \
    && make install \
    && echo 'extension=swoole.so' > /etc/php85/conf.d/99_swoole.ini \
    && php -r 'if (PHP_VERSION !== $argv[1] || PHP_ZTS || phpversion("swoole") !== $argv[2]) { exit(1); }' "$PHP_VERSION" "$SWOOLE_VERSION" \
    && apk del .php-build \
    && rm -rf /tmp/swoole /tmp/swoole.tgz
