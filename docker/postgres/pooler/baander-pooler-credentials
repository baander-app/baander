#!/usr/bin/env python3
"""Gives PgBouncer and each database role the same SCRAM-SHA-256 verifier.

PgBouncer can reuse a client's SCRAM proof for its own server login only when
its stored verifier is byte-identical to the role's. This helper derives a
verifier from the database password for the application role and for its
control role, applies them over a direct connection and writes the same
verifiers to PgBouncer's auth file. The control role exists because PgBouncer
sets query_wait_timeout per user; it is a member of the application role and
works on the same objects. A verifier already in the auth file keeps its salt,
so an unchanged password yields unchanged verifiers and a running pooler keeps
working.

Usage: baander-pooler-credentials DIRECTORY
Environment: PGPASSWORD (the database password), BAANDER_POOLER_USER,
BAANDER_POOLER_DATABASE and BAANDER_POOLER_SERVER_HOST.
"""

import base64
import hashlib
import hmac
import os
import pwd
import re
import secrets
import stringprep
import subprocess
import sys
import unicodedata

ITERATIONS = 4096
NAME = re.compile(r'[A-Za-z_][A-Za-z0-9_]{0,54}')
HOST = re.compile(r'[A-Za-z0-9][A-Za-z0-9.-]{0,252}')
ENTRY = re.compile(r'"([A-Za-z0-9_]+)" "SCRAM-SHA-256\$([0-9]+):([A-Za-z0-9+/=]+)\$[A-Za-z0-9+/=]+:[A-Za-z0-9+/=]+"')
SQL = '''SELECT format('CREATE ROLE %I', :'control') WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = :'control') \\gexec
ALTER ROLE :"control" WITH LOGIN INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE PASSWORD :'control_verifier';
GRANT :"role" TO :"control" WITH INHERIT TRUE;
ALTER ROLE :"role" PASSWORD :'verifier';
'''
PROHIBITED = (
    stringprep.in_table_c12, stringprep.in_table_c21, stringprep.in_table_c22,
    stringprep.in_table_c3, stringprep.in_table_c4, stringprep.in_table_c5,
    stringprep.in_table_c6, stringprep.in_table_c7, stringprep.in_table_c8,
    stringprep.in_table_c9,
)


def fail(message):
    print('baander-pooler-credentials: ' + message, file=sys.stderr)
    sys.exit(64)


def saslprep(password):
    """Normalizes a password as PostgreSQL's SASLprep does, or keeps its bytes where PostgreSQL would."""
    try:
        text = password.decode('utf-8')
    except UnicodeDecodeError:
        return password
    if text.isascii():
        return password
    mapped = ''.join(' ' if stringprep.in_table_c12(c) else c for c in text if not stringprep.in_table_b1(c))
    normalized = unicodedata.normalize('NFKC', mapped)
    if normalized == '' or any(check(c) for c in normalized for check in PROHIBITED):
        return password
    if any(stringprep.in_table_d1(c) for c in normalized):
        if any(stringprep.in_table_d2(c) for c in normalized) or not (
            stringprep.in_table_d1(normalized[0]) and stringprep.in_table_d1(normalized[-1])
        ):
            return password
    return normalized.encode('utf-8')


def verifier(password, salt, iterations):
    salted = hashlib.pbkdf2_hmac('sha256', saslprep(password), salt, iterations)
    client = hmac.new(salted, b'Client Key', hashlib.sha256).digest()
    server = hmac.new(salted, b'Server Key', hashlib.sha256).digest()
    encode = lambda value: base64.b64encode(value).decode('ascii')
    return 'SCRAM-SHA-256$%d:%s$%s:%s' % (iterations, encode(salt), encode(hashlib.sha256(client).digest()), encode(server))


def setting(name, pattern):
    value = os.environ.get(name, '')
    if pattern.fullmatch(value) is None:
        fail(name + ' must be a plain name.')
    return value


def main():
    if len(sys.argv) != 2 or not os.path.isdir(sys.argv[1]):
        fail('Usage: baander-pooler-credentials DIRECTORY')
    password = os.environb.get(b'PGPASSWORD', b'')
    if password == b'':
        fail('PGPASSWORD is required.')
    user = setting('BAANDER_POOLER_USER', NAME)
    database = setting('BAANDER_POOLER_DATABASE', NAME)
    host = setting('BAANDER_POOLER_SERVER_HOST', HOST)
    path = os.path.join(sys.argv[1], 'userlist.txt')

    control = user + '_control'
    saved = {}
    try:
        with open(path, encoding='ascii') as existing:
            for entry in ENTRY.finditer(existing.read()):
                saved[entry.group(1)] = (base64.b64decode(entry.group(3), validate=True), int(entry.group(2)))
    except FileNotFoundError:
        pass
    verifiers = {}
    for role in (user, control):
        salt, iterations = saved.get(role, (secrets.token_bytes(16), ITERATIONS))
        verifiers[role] = verifier(password, salt, iterations)

    subprocess.run(
        ['psql', '-X', '-q', '-v', 'ON_ERROR_STOP=1', '-h', host, '-p', '5432', '-U', user, '-d', database,
         '-v', 'role=' + user, '-v', 'control=' + control,
         '-v', 'verifier=' + verifiers[user], '-v', 'control_verifier=' + verifiers[control]],
        input=SQL.encode('ascii'), check=True, env=dict(os.environ, PGCONNECT_TIMEOUT='10'),
    )

    owner = pwd.getpwnam('postgres')
    temporary = path + '.tmp'
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, 'w', encoding='ascii') as output:
        output.write(''.join('"%s" "%s"\n' % entry for entry in verifiers.items()))
        output.flush()
        os.fsync(output.fileno())
    os.chown(temporary, owner.pw_uid, owner.pw_gid)
    os.replace(temporary, path)
    os.chown(sys.argv[1], owner.pw_uid, owner.pw_gid)
    os.chmod(sys.argv[1], 0o700)


if __name__ == '__main__':
    main()
