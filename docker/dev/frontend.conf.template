map $http_upgrade $connection_upgrade { default upgrade; '' close; }
resolver 127.0.0.11 valid=5s;
server {
    listen 80;
    server_name ${SERVER_NAME};
    allow ${GATEWAY_ADDRESS};
    deny all;
    root ${APP_HOME}/public;
    set $app_backend http://app:9501;
    set $vite_backend http://vite:5174;
    client_max_body_size 100m;
    access_log off;
    error_log /dev/null;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 86400s;
    location /assets/ { try_files $uri =404; }
    location = /auth-stream-worker.js { try_files $uri =404; }
    include /etc/nginx/preview.conf;
    location / { proxy_pass $app_backend; }
}
