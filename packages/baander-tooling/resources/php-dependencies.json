                {
                    "path": "Dockerfile",
                    "kind": "swoole-install"
                },
                {
                    "path": "docker/runner/Dockerfile",
                    "kind": "assignment",
                    "key": "SWOOLE_VERSION"
                },
                {
                    "path": "docker/nginx/Dockerfile.test",
                    "kind": "assignment",
                    "key": "SWOOLE_VERSION"
                },
                {
                    "path": "relay/docker/build-qualification-php.sh",
                    "kind": "assignment",
                    "key": "swoole_version"
                },
                {
                    "path": "composer.json",
                    "kind": "json",
                    "pointer": "/config/platform/ext-swoole"
                },
                {
                    "path": "packages/swoole-bundle/composer.json",
                    "kind": "json",
                    "pointer": "/require/upscale~1ext-swoole"
                },
                {
                    "path": "packages/swoole-bundle/composer.json",
                    "kind": "json",
                    "pointer": "/config/platform/ext-swoole"
                },
                {
                    "path": "composer.json",
                    "kind": "json",
                    "pointer": "/require/swoole~1ide-helper"
                }
            ]
        },
        "composer": {
            "source": "https://getcomposer.org/versions",
            "declarations": [
                {
                    "path": "Dockerfile",
                    "kind": "composer-image"
                },
                {
                    "path": "docker/runner/Dockerfile",
                    "kind": "composer-image"
                },
                {
                    "path": "relay/docker/Dockerfile",
                    "kind": "composer-image"
                },
                {
                    "path": "relay/docker/backup.Dockerfile",
                    "kind": "composer-image"
                },
                {
                    "path": "relay/docker/rqlite.Dockerfile",
                    "kind": "composer-image"
                }
            ]
        }
    },
    "patches": {
        "patches/swoole-bundle-z-engine-php85-zts-init.patch": {
            "package": "swoole-bundle/z-engine",
            "upstream": "https://github.com/symfony-swoole/z-engine",
            "reviewedReference": "5c06419c4a1aaf87fda0d8065dd050c7e3d5380e",
            "reviewedVersion": "8.5.2",
            "reason": "Stable upstream still rejects thread-safe PHP and lacks the typed-static initialization and TLS globals handling required by the application ZTS runtime.",
            "proofs": [
                "tests/Unit/Shared/Infrastructure/Swoole/ZEngineBootstrapRuntimeTest.php",
                "tests/Unit/Shared/Infrastructure/Swoole/GeneratedContainerLoadTest.php",
                "scripts/test-web-runtime-container.php"
            ]
        },
        "patches/symfony-redis-messenger-recoverable-delays.patch": {
            "package": "symfony/redis-messenger",
            "upstream": "https://github.com/symfony/redis-messenger",
            "reviewedReference": "484058b2e3055dc56be9b1463cf510e06228542c",
            "reviewedVersion": "8.1.10",
            "reason": "Upstream has lease-based recovery but does not preserve the bounded promotion and malformed-member retention required by the local delayed-delivery contract.",
            "proofs": [
                "tests/Integration/MessengerDelayedPromotionTest.php"
            ]
        }
    },
    "forks": {
        "swoole-bundle/swoole-bundle": {
            "path": "packages/swoole-bundle",
            "upstream": "https://github.com/symfony-swoole/swoole-bundle",
            "reviewedReference": "81f35b1fac4f7df2a173b6ae83a194e2ad6d8047",
            "reviewedVersion": "v0.35.6",
            "historicalBase": null,
            "comparison": "packages/swoole-bundle/upstream-review.json",
            "reason": "Local coroutine ownership, authenticated WebSockets, drain and streaming behavior require selective reconciliation against upstream.",
            "proofs": [
                "tests/Unit/Shared/Infrastructure/Swoole/CoWrapperSchedulingTest.php",
                "tests/Unit/Shared/Infrastructure/Swoole/WithWebSocketHandlerHandshakeTest.php",
                "tests/Unit/Shared/Infrastructure/Http/StreamedResponseProcessorTest.php",
                "scripts/test-web-shutdown-container.php"
            ]
        }
    },
