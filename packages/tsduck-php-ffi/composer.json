{
    "name": "tsduck/php",
    "description": "PHP FFI bindings for TSDuck - The MPEG Transport Stream Toolkit",
    "type": "library",
    "keywords": [
        "tsduck",
        "mpeg",
        "transport-stream",
        "dvb",
        "atsc",
        "isdb",
        "ffi"
    ],
    "license": "BSD-2-Clause",
    "require": {
        "php": ">=8.5",
        "ext-ffi": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.5"
    },
    "autoload": {
        "psr-4": {
            "Tsduck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tsduck\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php -d ffi.enable=true vendor/bin/phpunit --configuration phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
