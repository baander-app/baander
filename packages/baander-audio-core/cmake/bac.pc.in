prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: bac
Description: Bånder Audio Core, the Bånder AAC and FLAC encoder and decoder library
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lbac
Libs.private: -lstdc++ -lm
