includes:
    - vendor/baander/phpstan-rules/extension.neon

parameters:
    level: 6
    # Per checkout, and apart from the application configuration's cache: the default system
    # temp directory is shared by every worktree, and a cache written by another checkout
    # points at that checkout's PHPStan and fails here.
    tmpDir: var/cache/phpstan-tooling
    paths:
        - packages/baander-configuration/src
        - packages/baander-configuration/tests
        - packages/baander-containers/src
        - packages/baander-containers/tests
        - packages/baander-deployment/src
        - packages/baander-deployment/tests
        - packages/baander-dev-ci/src
        - packages/baander-dev-ci/tests
        - packages/baander-dev-dependencies/src
        - packages/baander-dev-dependencies/tests
        - packages/baander-dev-environment/src
        - packages/baander-dev-environment/tests
        - packages/baander-dev-qualification/src
        - packages/baander-dev-qualification/tests
        - packages/baander-dev-registry/src
        - packages/baander-dev-registry/tests
        - packages/baander-dev-website/src
        - packages/baander-dev-website/tests
        - packages/baander-filesystem/src
        - packages/baander-filesystem/tests
        - packages/baander-images/src
        - packages/baander-images/tests
        - packages/baander-process/src
        - packages/baander-process/tests
        - packages/baander-core/src
        - packages/baander-core/tests
        - scripts
        - tests/Support/Tooling
        - tests/Tooling
        - relay/tests
        - relay/tools
        - .agents/skills/prose-fix/scripts
        - tests/Fixtures/Http/dns-orphan-supervisor.php
        - tests/Fixtures/Http/dns-server.php
        - tests/Fixtures/Worker/autoscaling-verify.php
        - tests/Fixtures/Worker/control-capacity-postgres-sample.php
        - tests/Fixtures/Worker/control-capacity-verify.php
        - tests/Fixtures/Worker/legacy-runtime.php
        - tests/Fixtures/Worker/lifecycle-checkpoint.php
        - tests/Fixtures/Worker/media-control-verify.php
    excludePaths:
        analyseAndScan:
            - scripts/vendor
            - scripts/backend-test-runner.php
            - scripts/e2e-ingest-video.php
            - scripts/retain-build-evidence.php
            - scripts/web-runtime
    bootstrapFiles:
        - vendor/autoload.php
    stubFiles:
        - packages/baander-dev-website/phpstan/ffi.stub
