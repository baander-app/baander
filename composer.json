    "ext-gmp": "*",
    "ext-hash": "*",
    "ext-iconv": "*",
    "ext-inotify": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pcntl": "*",
    "ext-pcre": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-pgsql": "*",
    "ext-posix": "*",
    "ext-random": "*",
    "ext-redis": "*",
    "ext-reflection": "*",
    "ext-session": "*",
    "ext-simplexml": "*",
    "ext-sockets": "*",
