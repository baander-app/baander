    "ext-spl": "*",
    "ext-sqlite3": "*",
    "ext-swoole": "*",
    "ext-tokenizer": "*",
    "ext-uri": "*",
    "ext-xml": "*",
    "ext-zip": "*",
    "ext-zlib": "*",
    "baander/core": "dev-main@dev",
    "baander/http-client": "dev-main@dev",
    "baander/image-processing": "dev-main@dev",
    "baander/media-metadata": "dev-main@dev",
    "baander/redis-rate-limiter": "dev-main@dev",
    "cweagans/composer-patches": "^2.0",
    "defuse/php-encryption": "^2.4",
    "doctrine/doctrine-bundle": "^3.4.2",
    "doctrine/doctrine-migrations-bundle": "^4.0.1",
    "doctrine/orm": "^3.8.0",
    "dragonmantank/cron-expression": "^3.6.1",
    "erusev/parsedown": ">=1.8",
    "guzzlehttp/guzzle": "^8.6.0",
    "guzzlehttp/psr7": "^3.6.0",
    "hidehalo/nanoid-php": "^2.0",
    "lcobucci/jwt": "^5.7.0",
    "league/oauth2-server": "^9.5.0",
    "minishlink/web-push": "^11.0.0",
    "nelmio/cors-bundle": "^2.6.1",
    "nyholm/psr7": "^1.8.2",
    "open-telemetry/api": ">=1.12.0",
    "open-telemetry/context": ">=1.6",
    "open-telemetry/exporter-otlp": ">=1.6",
    "open-telemetry/sdk": ">=1.17",
    "pentatrion/vite-bundle": "^8.2.4",
    "php-http/httplug": "^2.4.1",
    "predis/predis": "^3.8.0",
    "ramsey/uuid": "^4.10.0",
    "spomky-labs/cbor-php": "^3.4.2",
    "spomky-labs/otphp": "^11.5.1",
    "swoole-bundle/swoole-bundle": "@dev",
    "swoole-bundle/z-engine": "8.5.2",
    "swoole/ide-helper": "6.2.4",
    "symfony/asset": "~8.1.0",
    "symfony/cache": "~8.1.11",
    "symfony/console": "~8.1.11",
    "symfony/doctrine-messenger": "~8.1.11",
    "symfony/dotenv": "~8.1.6",
    "symfony/expression-language": "~8.1.9",
    "symfony/flex": "^2.12",
    "symfony/framework-bundle": "~8.1.11",
    "symfony/http-client": "~8.1.11",
    "symfony/mailer": "~8.1.10",
    "symfony/messenger": "~8.1.11",
    "symfony/monolog-bundle": "^4.0.2",
    "symfony/notifier": "~8.1.11",
    "symfony/psr-http-message-bridge": "~8.1.9",
    "symfony/rate-limiter": "~8.1.11",
    "symfony/redis-messenger": "~8.1.11",
    "symfony/runtime": "~8.1.11",
    "symfony/security-bundle": "~8.1.11",
    "symfony/serializer": "~8.1.11",
    "symfony/translation": "~8.1.11",
    "symfony/twig-bundle": "~8.1.9",
    "symfony/uid": "~8.1.9",
    "symfony/validator": "~8.1.11",
    "symfony/workflow": "~8.1.8",
    "symfony/yaml": "~8.1.11",
    "tsduck/php": "@dev",
    "web-auth/webauthn-lib": "^5.3.17",
    "zircote/swagger-php": "^7.9"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "ext-phar": "*",
    "ext-xmlwriter": "*",
    "ext-yaml": "*",
    "baander/configuration": "dev-main@dev",
    "baander/containers": "dev-main@dev",
    "baander/deployment": "dev-main@dev",
    "baander/dev-ci": "dev-main@dev",
    "baander/dev-dependencies": "dev-main@dev",
    "baander/dev-environment": "dev-main@dev",
    "baander/dev-qualification": "dev-main@dev",
    "baander/dev-registry": "dev-main@dev",
    "baander/dev-website": "dev-main@dev",
    "baander/filesystem": "dev-main@dev",
    "baander/images": "dev-main@dev",
    "baander/phpstan-rules": "@dev",
    "baander/process": "dev-main@dev",
    "brianium/paratest": "^7.30.0",
    "dama/doctrine-test-bundle": "^8.8.0",
    "deptrac/deptrac": "^4.7.2",
    "ergebnis/composer-normalize": "^2.59",
    "php-cs-fixer/shim": "^3.95.32",
    "phpstan/phpstan": "^2.3.7",
    "phpstan/phpstan-doctrine": "^2.1.2",
    "phpstan/phpstan-symfony": "^2.1.1",
    "phpunit/phpunit": "^13.4.8",
    "reliforp/reli-prof": "^0.12.0",
    "symfony/browser-kit": "~8.1.11",
    "symfony/phpunit-bridge": "~8.1.10",
    "symfony/stopwatch": "~8.1.0",
    "symfony/web-profiler-bundle": "~8.1.11",
    "web-token/jwt-library": "^4.2.8",
    "zenstruck/foundry": "^2.17.0"
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": ">=1.31.0",
    "symfony/polyfill-php84": "*"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "repositories": [
    {
      "type": "path",
      "url": "./packages/baander-phpstan-rules",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "./packages/swoole-bundle",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "./packages/tsduck-php-ffi",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-media-metadata",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/media-metadata": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-image-processing",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/image-processing": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-redis-rate-limiter",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/redis-rate-limiter": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-http-client",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/http-client": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-configuration",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/configuration": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-containers",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/containers": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-core",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/core": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-deployment",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/deployment": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-dev-ci",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/dev-ci": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-dev-dependencies",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/dev-dependencies": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-dev-environment",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/dev-environment": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-dev-qualification",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/dev-qualification": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-dev-registry",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/dev-registry": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-dev-website",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/dev-website": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-filesystem",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/filesystem": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-images",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/images": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-process",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/process": "dev-main"
        }
      }
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/",
      "Baander\\Configuration\\Tests\\": "packages/baander-configuration/tests/",
      "Baander\\Containers\\Tests\\": "packages/baander-containers/tests/",
      "Baander\\Core\\Tests\\": "packages/baander-core/tests/",
      "Baander\\Deployment\\Tests\\": "packages/baander-deployment/tests/",
      "Baander\\DevCi\\Tests\\": "packages/baander-dev-ci/tests/",
      "Baander\\DevDependencies\\Tests\\": "packages/baander-dev-dependencies/tests/",
      "Baander\\DevEnvironment\\Tests\\": "packages/baander-dev-environment/tests/",
      "Baander\\DevQualification\\Tests\\": "packages/baander-dev-qualification/tests/",
      "Baander\\DevRegistry\\Tests\\": "packages/baander-dev-registry/tests/",
      "Baander\\DevWebsite\\Tests\\": "packages/baander-dev-website/tests/",
      "Baander\\Filesystem\\Tests\\": "packages/baander-filesystem/tests/",
      "Baander\\HttpClient\\Tests\\": "packages/baander-http-client/tests/",
      "Baander\\ImageProcessing\\Tests\\": "packages/baander-image-processing/tests/",
      "Baander\\Images\\Tests\\": "packages/baander-images/tests/",
      "Baander\\MediaMetadata\\Tests\\": "packages/baander-media-metadata/tests/",
      "Baander\\Process\\Tests\\": "packages/baander-process/tests/",
      "Baander\\RedisRateLimiter\\Tests\\": "packages/baander-redis-rate-limiter/tests/",
      "Baander\\Tests\\Tooling\\": "tests/Tooling/",
      "Baander\\Tests\\Tooling\\Support\\": "tests/Support/Tooling/"
    }
  },
  "config": {
    "allow-plugins": {
      "cweagans/composer-patches": true,
      "ergebnis/composer-normalize": true,
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true,
      "tbachert/spi": true
    },
    "bump-after-update": true,
    "platform": {
      "ext-swoole": "6.2.4"
    },
    "sort-packages": true
  },
  "extra": {
    "patches": {
      "swoole-bundle/z-engine": {
        "PHP 8.5 ZTS init + typed properties": "patches/swoole-bundle-z-engine-php85-zts-init.patch"
      },
      "symfony/redis-messenger": {
        "Keep delayed deliveries recoverable until stream insertion succeeds": "patches/symfony-redis-messenger-recoverable-delays.patch"
      }
    },
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "analyse:tooling": [
      "@tooling:autoload",
      "@php vendor/bin/phpstan analyse --configuration phpstan-tooling.neon --memory-limit=1G"
    ],
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "check:js-dependencies": "@php scripts/check-js-dependencies.php --online",
    "check:js-dependencies:local": "@php scripts/check-js-dependencies.php --local-only",
    "check:php-dependencies": "@php scripts/check-php-dependencies.php",
    "check:php-dependencies:local": "@php scripts/check-php-dependencies.php --local-only",
    "check:tooling-architecture": [
      "@deptrac:tooling",
      "@check:tooling-source-policy"
    ],
    "check:tooling-format": "@php vendor/bin/php-cs-fixer check --config=.php-cs-fixer.tooling.php --using-cache=no",
    "check:tooling-source-policy": "@php scripts/check-tooling-source-policy.php",
    "deptrac": "deptrac analyse",
    "deptrac:baseline": "deptrac analyse --formatter=baseline --output=deptrac.baseline.yaml",
    "deptrac:graph": "deptrac analyse --formatter=graphviz --output=deptrac-graph.dot",
    "deptrac:tooling": "@php vendor/bin/deptrac analyse --config-file=deptrac-tooling.yaml --no-cache --no-progress",
    "format:tooling": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.tooling.php",
    "openapi": "./bin/console app:export-openapi-spec  --format=json --output=openapi.json",
    "test:registry-subjects": [
      "@tooling:autoload",
      "@php vendor/bin/phpunit --configuration phpunit-tooling.xml.dist --group registry-python-subject"
    ],
    "test:tooling": [
      "@tooling:autoload",
      "@php vendor/bin/phpunit --configuration phpunit-tooling.xml.dist --exclude-group registry-python-subject"
    ],
    "tooling:autoload": [
      "@composer --working-dir=scripts install --optimize-autoloader --no-interaction --no-scripts --no-plugins",
      "@composer --working-dir=relay install --no-dev --optimize-autoloader --no-interaction --no-scripts --no-plugins"
    ]
  }
}
