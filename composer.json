{
  "name": "martinjuul/baander",
  "description": "Self-hosted media library and streaming server.",
  "license": "Apache-2.0",
  "type": "project",
  "require": {
    "php": ">=8.5",
    "ext-ctype": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-inotify": "*",
    "ext-openssl": "*",
    "ext-pcntl": "*",
    "ext-pdo": "*",
    "ext-pgsql": "*",
    "ext-posix": "*",
    "ext-redis": "*",
    "ext-sockets": "*",
    "ext-swoole": "*",
    "cweagans/composer-patches": "^2.0",
    "defuse/php-encryption": "^2.4",
    "doctrine/doctrine-bundle": "^3.3.4",
    "doctrine/doctrine-migrations-bundle": "^4.0.1",
    "doctrine/orm": "^3.7.6",
    "dragonmantank/cron-expression": "^3.6.1",
    "erusev/parsedown": ">=1.8",
    "guzzlehttp/guzzle": "^8.3.1",
    "guzzlehttp/psr7": "^3.2.0",
    "hidehalo/nanoid-php": "^2.0",
    "league/oauth2-server": "^9.4.1",
    "minishlink/web-push": "^11.0.0",
    "nelmio/api-doc-bundle": "^5.13.2",
    "nelmio/cors-bundle": "^2.6.1",
    "nyholm/psr7": "^1.8.2",
    "open-telemetry/api": ">=1.10.1",
    "open-telemetry/context": ">=1.5",
    "open-telemetry/exporter-otlp": ">=1.4",
    "open-telemetry/sdk": ">=1.15",
    "pentatrion/vite-bundle": "^8.2.4",
    "php-http/httplug": "^2.4.1",
    "predis/predis": "^3.7.0",
    "ramsey/uuid": "^4.9.4",
    "spomky-labs/cbor-php": "^3.4.2",
    "spomky-labs/otphp": "^11.5.0",
    "swoole-bundle/swoole-bundle": "@dev",
    "swoole-bundle/z-engine": "8.5.2",
    "swoole/ide-helper": "6.2.4",
    "symfony/asset": "~8.1.0",
    "symfony/cache": "~8.1.10",
    "symfony/console": "~8.1.10",
    "symfony/doctrine-messenger": "~8.1.10",
    "symfony/dotenv": "~8.1.6",
    "symfony/expression-language": "~8.1.9",
    "symfony/flex": "^2.12",
    "symfony/framework-bundle": "~8.1.10",
    "symfony/http-client": "~8.1.10",
    "symfony/mailer": "~8.1.10",
    "symfony/messenger": "~8.1.10",
    "symfony/monolog-bundle": "^4.0.2",
    "symfony/notifier": "~8.1.10",
    "symfony/psr-http-message-bridge": "~8.1.9",
    "symfony/rate-limiter": "~8.1.10",
    "symfony/redis-messenger": "~8.1.10",
    "symfony/runtime": "~8.1.10",
    "symfony/security-bundle": "~8.1.10",
    "symfony/serializer": "~8.1.10",
    "symfony/translation": "~8.1.10",
    "symfony/twig-bundle": "~8.1.9",
    "symfony/uid": "~8.1.9",
    "symfony/validator": "~8.1.10",
    "symfony/workflow": "~8.1.8",
    "symfony/yaml": "~8.1.10",
    "tsduck/php": "@dev",
    "web-auth/webauthn-lib": "^5.3.9"
  },
  "require-dev": {
    "baander/phpstan-rules": "@dev",
    "baander/tooling": "dev-main",
    "brianium/paratest": "^7.27.5",
    "dama/doctrine-test-bundle": "^8.7.0",
    "deptrac/deptrac": "^4.7.2",
    "ergebnis/composer-normalize": "^2.56",
    "php-cs-fixer/shim": "^3.95",
    "phpstan/phpstan": "^2.3.4",
    "phpstan/phpstan-doctrine": "^2.1.0",
    "phpstan/phpstan-symfony": "^2.1.1",
    "phpunit/phpunit": "^13.4.5",
    "reliforp/reli-prof": "^0.12.0",
    "symfony/browser-kit": "~8.1.10",
    "symfony/phpunit-bridge": "~8.1.10",
    "symfony/stopwatch": "~8.1.0",
    "symfony/web-profiler-bundle": "~8.1.10",
    "zenstruck/foundry": "^2.15.0"
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": ">=1.31.0",
    "symfony/polyfill-php84": "*"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "repositories": [
    {
      "type": "path",
      "url": "./packages/baander-tooling",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "baander/tooling": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "./packages/baander-phpstan-rules",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "./packages/swoole-bundle",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "./packages/tsduck-php-ffi",
      "options": {
        "symlink": true
      }
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    },
    "classmap": [
      "scripts/tests/php/"
    ]
  },
  "config": {
    "allow-plugins": {
      "cweagans/composer-patches": true,
      "ergebnis/composer-normalize": true,
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true,
      "tbachert/spi": true
    },
    "bump-after-update": true,
    "platform": {
      "ext-swoole": "6.2.4"
    },
    "sort-packages": true
  },
  "extra": {
    "patches": {
      "swoole-bundle/z-engine": {
        "PHP 8.5 ZTS init + typed properties": "patches/swoole-bundle-z-engine-php85-zts-init.patch"
      },
      "symfony/redis-messenger": {
        "Keep delayed deliveries recoverable until stream insertion succeeds": "patches/symfony-redis-messenger-recoverable-delays.patch"
      }
    },
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  },
  "scripts": {
    "analyse:tooling": [
      "@tooling:autoload",
      "@php vendor/bin/phpstan analyse --configuration phpstan-tooling.neon --memory-limit=1G"
    ],
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "check:js-dependencies": "@php scripts/check-js-dependencies.php --online",
    "check:js-dependencies:local": "@php scripts/check-js-dependencies.php --local-only",
    "check:php-dependencies": "@php scripts/check-php-dependencies.php",
    "check:php-dependencies:local": "@php scripts/check-php-dependencies.php --local-only",
    "check:tooling-architecture": [
      "@deptrac:tooling",
      "@check:tooling-source-policy"
    ],
    "check:tooling-format": "@php vendor/bin/php-cs-fixer check --config=.php-cs-fixer.tooling.php --using-cache=no",
    "check:tooling-source-policy": "@php scripts/check-tooling-source-policy.php",
    "deptrac": "deptrac analyse",
    "deptrac:baseline": "deptrac analyse --formatter=baseline --output=deptrac.baseline.yaml",
    "deptrac:graph": "deptrac analyse --formatter=graphviz --output=deptrac-graph.dot",
    "deptrac:tooling": "@php vendor/bin/deptrac analyse --config-file=deptrac-tooling.yaml --no-cache --no-progress",
    "format:tooling": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.tooling.php",
    "openapi": "./bin/console app:export-openapi-spec  --format=json --output=openapi.json",
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "test:registry-subjects": [
      "@tooling:autoload",
      "@php vendor/bin/phpunit --configuration phpunit-tooling.xml.dist --group registry-python-subject"
    ],
    "test:tooling": [
      "@tooling:autoload",
      "@php vendor/bin/phpunit --configuration phpunit-tooling.xml.dist --exclude-group registry-python-subject"
    ],
    "tooling:autoload": [
      "@composer --working-dir=scripts install --no-dev --optimize-autoloader --no-interaction --no-scripts --no-plugins",
      "@composer --working-dir=relay install --no-dev --optimize-autoloader --no-interaction --no-scripts --no-plugins"
    ]
  }
}
