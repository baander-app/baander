* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Unified diffs encode blank context lines with a space.
patches/*.patch whitespace=-blank-at-eol,-blank-at-eof

# Preserve the checksum of the migration already applied to local instances.
migrations/Version20261030210000.php whitespace=-blank-at-eol

/.github export-ignore
CHANGELOG.md export-ignore

# Upstream notice bytes are hashed as retained source evidence.
relay/third_party/inventory/*/licenses/** -text -whitespace
relay/third_party/inventory/go/*.buildinfo.txt -text -whitespace
relay/third_party/inventory/native/licenses/openssl/AUTHORS.md conflict-marker-size=32
